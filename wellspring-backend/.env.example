# --- Database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wellspring

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Chat / LLM ---
# Groq is used for safety + reflection/chat generation.
# Get a key at: https://console.groq.com/
GROQ_API_KEY=

# Optional extra fallbacks supported by the current provider layer.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

GROQ_CHAT_MODEL=openai/gpt-oss-20b

# --- Embeddings ---
# Gemini is used only for embeddings; Groq remains the chat LLM provider.
# Gemini Embedding 001 supports reduced output dimensions; 768 matches the
# MongoDB Atlas Vector Search indexes used by Wellspring.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# --- Server ---
PORT=4000
NODE_ENV=development

# --- CORS ---
CORS_ORIGIN=http://localhost:5173
